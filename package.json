{
  "name": "crizon-app",
  "version": "1.0.0",
  "private": true,
  "description": "Crizon - Capacitor Android wrapper (exact HTML/CSS/JS design preserved, native permissions added on top)",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:bridge": "esbuild src/native-bridge-src.js --bundle --format=iife --outfile=www/native-bridge.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@capgo/capacitor-navigation-bar": "^6.0.0",
    "@capacitor-community/media": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "esbuild": "^0.23.1"
  }
}
